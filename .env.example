# Copy to .env locally. Never commit real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
BITSO_API_KEY=
BITSO_API_SECRET=
DASHBOARD_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Safe defaults. Live trading needs both TRADING_MODE=live and explicit enablement.
TRADING_MODE=paper
BITSO_LIVE_ENABLED=false
BITSO_MARGIN_SHORTS_ENABLED=false
BITSO_MARGIN_ACCOUNT_CONFIRMED=false
MODEL_APPROVED=false
APPROVED_MODEL_MANIFEST=

# The dashboard is localhost-only unless you explicitly change this.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Set to true to skip downloading new data and use only the local cache.
# Useful for re-running the pipeline without hitting the Alpaca API.
# Can also be passed as --cache-only on the command line.
CACHE_ONLY=true

# RL Pipeline Toggles and Timesteps (optional, defaults shown)
# Turn models on/off to speed up backtests.
RL_RECURRENT_PPO_ENABLED=true
RL_RECURRENT_PPO_TIMESTEPS=100000

RL_SAC_ENABLED=true
RL_SAC_TIMESTEPS=100000

RL_TQC_ENABLED=true
RL_TQC_TIMESTEPS=100000

RL_CVAR_QRDQN_ENABLED=true
RL_CVAR_QRDQN_TIMESTEPS=100000

RL_EVALUATIONS=5
# Increase until GPU utilization saturates; reduce if CPU or RAM becomes the limit.
RL_RECURRENT_PPO_ENVS=16

# Validation & Cross-Validation Settings (optional, defaults shown)
# Total full-profile jobs per algorithm = (temporal_groups choose test_groups) * full_seeds
# E.g. 3 groups choose 2 = 3 folds * 2 seeds = 6 jobs per algorithm.
VALIDATION_TEMPORAL_GROUPS=3
VALIDATION_TEST_GROUPS=2
VALIDATION_FULL_SEEDS=2
VALIDATION_EMBARGO_BARS=200
VALIDATION_MONTE_CARLO_PATHS=5000
# Full-profile outer walk-forward windows. The newest holdout is never used for checkpoint selection.
VALIDATION_TRAIN_MONTHS=36
VALIDATION_VAL_MONTHS=6
VALIDATION_EVAL_MONTHS=6
VALIDATION_STEP_MONTHS=6
VALIDATION_HOLDOUT_MONTHS=6
# Conservative fallback execution assumptions; replace with measured Bitso values locally.
VALIDATION_COMMISSION_BPS=10
VALIDATION_BASE_SPREAD_BPS=2
VALIDATION_STRESS_SPREAD_MULTIPLIER=2
VALIDATION_STRESS_SLIPPAGE_ATR_FRACTION=0.02
